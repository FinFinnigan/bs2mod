# BoyShop backend configuration — copy to .env.local (NEVER commit real secrets).
# All values are optional; the storefront runs on the mock data layer with no config.

# --- Payment (provider-neutral registry, ARCHITECTURE.md §6.1) ---
# Active provider id. Default "mock" (no credentials, safe).
PAYMENT_PROVIDER=mock
# Enabled provider ids (comma-separated). Add an adapter then list it here.
PAYMENT_PROVIDERS=mock

# Stripe (test-mode only until live is separately authorized). Only read by the
# Stripe adapter; keep test keys here, never live keys in version control.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Mollie (test-mode only until live is separately authorized). Only read by the
# Mollie adapter; keep test keys here, never live keys in version control.
# MOLLIE_API_KEY=test_...
# MOLLIE_WEBHOOK_SECRET=...
# Live mode is fail-closed: a live_* MOLLIE_API_KEY is rejected unless this flag
# is explicitly true. Do NOT set it without the CEO's live-payment authorization.
# MOLLIE_ALLOW_LIVE=true

# --- Database (live data layer; leave unset to use the mock adapter) ---
# DATABASE_URL=postgres://user:pass@host/db

# --- Admin bootstrap (npm run db:create-admin) ---
# AUTH_ADMIN_EMAIL=admin@boyshop.ie
# AUTH_ADMIN_PASSWORD=change-me

# --- Feature flags (admin-controlled, no source edit) ---
FEATURE_WISHLIST=true
FEATURE_REVIEWS=false
FEATURE_ACCOUNT=false
FEATURE_PROMOTIONS=false
FEATURE_RECOMMENDATIONS=false

# --- Shipping (data, not code) ---
SHIPPING_FREE_THRESHOLD=50
SHIPPING_FLAT_RATE=4.95
